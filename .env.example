# --- LLM -------------------------------------------------------------
# auto = OpenAI if OPENAI_API_KEY is set, else Gemini if GOOGLE_API_KEY is set, else offline mock
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Storage ---------------------------------------------------------
# local = ./storage folder (same key layout as S3); s3 = AWS S3 bucket
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=followup
AWS_REGION=us-east-1

# --- Vector store ----------------------------------------------------
# chroma = persistent ChromaDB in ./vectorstore; memory = in-process
VECTOR_BACKEND=chroma

# --- Rules -----------------------------------------------------------
DUPLICATE_REMINDER_WINDOW_DAYS=2
UPCOMING_WINDOW_DAYS=7
