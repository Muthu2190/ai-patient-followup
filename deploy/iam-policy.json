{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListFollowupBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR-FOLLOWUP-BUCKET"
    },
    {
      "Sid": "ReadWriteFollowupObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR-FOLLOWUP-BUCKET/*"
    },
    {
      "Sid": "ReadLlmApiKeys",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:*:*:secret:followup/llm-keys-*"
    }
  ]
}
